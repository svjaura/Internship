# Refi Watch environment variables.
# Copy to .env.local for local work. Never commit real values and never paste them in chat.
# With none of these set, the app runs in local test mode: the dashboard serves the demo's
# 13 test loans from memory, staff login is off, and the connect page simulates Plaid.

# --- Plaid (Weber Mortgage's own Plaid account, free Trial plan) ---
# Never apply for Production access: that ends the free Trial.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
# The Trial plan's "Production" secret, used for Michael's real loan.
PLAID_SECRET_PRODUCTION=
# sandbox while building; production to use the Trial keys.
PLAID_ENV=sandbox
# Optional: if set, used instead of the per-environment secret above.
PLAID_SECRET=
# Public URL of the webhook route. Plaid sends LIABILITIES and ITEM webhooks here.
PLAID_WEBHOOK_URL=https://your-app.vercel.app/api/plaid/webhook
# Optional: needed for OAuth banks (Chase, Wells Fargo, Bank of America) in a phone browser.
# Must also be added in the Plaid dashboard under Allowed redirect URIs.
PLAID_REDIRECT_URI=

# --- Supabase (US region) ---
SUPABASE_URL=
# Public by design; protected by row-level security. Sent to the staff login page.
SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Access token encryption (AES-256-GCM) ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# If this key is lost, stored Plaid tokens cannot be decrypted. Keep a copy in a password manager.
TOKEN_ENCRYPTION_KEY=

# --- Compliance switches ---
# Borrower-facing refinance numbers are rate advertising. Keep false until Michael approves
# the wording and disclosures. Only the exact value "true" turns it on.
BORROWER_REFI_VIEW=false

# Optional: https link to Weber Mortgage's privacy notice, shown on the consent page.
PRIVACY_NOTICE_URL=
